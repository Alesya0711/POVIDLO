PROJECT_NAME="Капибанк"
VERSION="0.3.0"
API_V1_STR="/api/v1"
ENVIRONMENT="local"

POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=kapibank
POSTGRES_PASSWORD=kapibank_secret
POSTGRES_DB=kapibank

BACKEND_CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:4173","http://127.0.0.1:8080","http://localhost:5173","http://localhost:4173"]

FRONTEND_DIST_DIR="/app/frontend-dist"

DATA_VERSION="demo-data-1"
RULES_VERSION="demo-rules-1"
REPORTING_DATE="2026-10-01"

SECRET_KEY="kapibank-dev-secret-key-change-me"
# Use LLM_MODE=stub for an offline demo without a model.
LLM_MODE="groq"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_COMPLETION_TOKENS=2048
# Optional local/test override. Docker always uses bundled PostgreSQL.
# DATABASE_URL="postgresql+psycopg://user:password@127.0.0.1:5432/kapibank"
