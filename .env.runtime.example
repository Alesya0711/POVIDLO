# Local HTTP demo. Copy to .env.runtime and set values locally.
ENVIRONMENT=local
VERSION=0.3.0
FRONTEND_DIST_DIR=/app/frontend-dist
POSTGRES_USER=kapibank
POSTGRES_PASSWORD=change-me-local-demo
POSTGRES_DB=kapibank
SECRET_KEY=change-me-local-demo-secret
# Use LLM_MODE=stub for an offline demo without a model.
LLM_MODE=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_COMPLETION_TOKENS=2048
