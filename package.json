{
  "name": "kapibank-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:palette": "node development/tools/palette/check.mjs",
    "check:home-contrast": "node development/tools/palette/check-home.mjs",
    "test:questionnaire": "node --test development/tests/frontend/questionnaire.test.mjs",
    "check:questionnaire-contrast": "node development/tools/palette/check-questionnaire.mjs",
    "check:recommendations-contrast": "node development/tools/palette/check-recommendations.mjs",
    "check:assistant-contrast": "node development/tools/palette/check-assistant.mjs",
    "test:product": "node --test development/tests/frontend/product.test.mjs",
    "check:product-contrast": "node development/tools/palette/check-product.mjs",
    "check:catalog-contrast": "node development/tools/palette/check-catalog.mjs",
    "check:application-contrast": "node development/tools/palette/check-application.mjs",
    "check:application-details-contrast": "node development/tools/palette/check-application-details.mjs",
    "check:profile-contrast": "node development/tools/palette/check-profile.mjs",
    "check:contract-contrast": "node development/tools/palette/check-contract.mjs",
    "check:bank-queue-contrast": "node development/tools/palette/check-bank-queue.mjs",
    "check:bank-review-contrast": "node development/tools/palette/check-bank-review.mjs",
    "test": "node --test development/tests/frontend/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "decimal.js": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
