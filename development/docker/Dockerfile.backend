FROM python:3.12.7-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PGDATA=/var/lib/postgresql/data/pgdata \
    PORT=8080

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY kapibank-backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY kapibank-backend/app /app/app
COPY kapibank-backend/alembic /app/alembic
COPY kapibank-backend/alembic.ini /app/alembic.ini
COPY kapibank-backend/entrypoint.sh /app/entrypoint.sh
RUN mkdir -p /app/frontend-dist && chmod +x /app/entrypoint.sh

VOLUME ["/var/lib/postgresql/data"]

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]