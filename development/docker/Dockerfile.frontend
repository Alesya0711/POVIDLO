# syntax=docker/dockerfile:1
FROM node:24.21.0-bookworm-slim AS frontend-build
WORKDIR /build/frontend
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
COPY assets ./assets
COPY public ./public
RUN npm run build

# Export these files into the backend runtime image; this is not a web server.
FROM scratch AS frontend-artifact
COPY --from=frontend-build /build/frontend/dist /dist
